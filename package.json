{
	"name": "bndlkt",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Microfrontend orchestration toolkit",
	"main": "index.js",
	"scripts": {
		"build": "pnpm -r build",
		"prepare": "husky && git config --local commit.template .gitmessage",
		"check:types": "pnpm -r check:types",
		"check:lint": "eslint . --max-warnings 0",
		"check:all": "pnpm run check:types && pnpm run check:lint",
		"check:deps": "depcheck"
	},
	"keywords": [
		"microfrontends",
		"bundles",
		"dependency-management",
		"scopes"
	],
	"author": "Yuri Burilov <cyberronin1101@gmail.com>",
	"license": "MIT",
	"packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.4",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"depcheck": "^1.4.7",
		"eslint": "^9.39.4",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^15.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"prettier-plugin-multiline-arrays": "^4.1.8",
		"typescript-eslint": "^8.60.0"
	}
}
